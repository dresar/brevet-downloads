generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  role      String   @default("USER")
  avatar    String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile         UserProfile?
  sessions        Session[]
  attempts        Attempt[]
  mistakes        Mistake[]
  remedials       Remedial[]
  progress        UserProgress[]
  topicProgress   TopicProgress[]
  bookmarks       Bookmark[]
  simulations     Simulation[]
  achievements    UserAchievement[]
  studySessions   StudySession[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserProfile {
  id            String   @id @default(cuid())
  userId        String   @unique
  bio           String?
  company       String?
  position      String?
  education     String?
  brevetCert    String?
  xp            Int      @default(0)
  level         Int      @default(1)
  streak        Int      @default(0)
  longestStreak Int      @default(0)
  lastActiveAt  DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  icon        String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  topics      Topic[]
}

model Topic {
  id          String   @id @default(cuid())
  categoryId  String
  name        String
  slug        String   @unique
  description String?
  icon        String?
  order       Int      @default(0)
  questionCount Int   @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category    Category    @relation(fields: [categoryId], references: [id])
  subtopics   Subtopic[]
  questions   Question[]
  progress    TopicProgress[]
}

model Subtopic {
  id          String   @id @default(cuid())
  topicId     String
  name        String
  slug        String
  description String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  topic       Topic       @relation(fields: [topicId], references: [id])
  questions   Question[]
}

model Question {
  id              String   @id @default(cuid())
  topicId         String
  subtopicId      String?
  categoryId      String?
  difficulty      Int      @default(1)
  questionType    String   @default("multiple_choice")
  question        String
  options         String   @default("[]")
  correctAnswer   String
  shortExplanation String?
  fullExplanation  String?
  whyCorrect      String?
  whyWrong        String?
  concept         String?
  calculation     String?
  formula         String?
  journal         String?
  commonMistake   String?
  relatedTopics   String?
  source          String?
  sourceType      String   @default("generated")
  regulationYear  String?
  status          String   @default("APPROVED")
  timesAnswered   Int      @default(0)
  timesCorrect    Int      @default(0)
  avgTimeMs       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  topic           Topic     @relation(fields: [topicId], references: [id])
  subtopic        Subtopic? @relation(fields: [subtopicId], references: [id])
  attempts        Attempt[]
  mistakes        Mistake[]
}

model Attempt {
  id              String   @id @default(cuid())
  userId          String
  questionId      String
  userAnswer      String
  isCorrect       Boolean
  timeMs          Int
  xpEarned        Int      @default(0)
  simulationId    String?
  createdAt       DateTime @default(now())

  user            User      @relation(fields: [userId], references: [id])
  question        Question  @relation(fields: [questionId], references: [id])
  simulation      Simulation? @relation(fields: [simulationId], references: [id])
}

model Mistake {
  id              String   @id @default(cuid())
  userId          String
  questionId      String
  userAnswer      String
  correctAnswer   String
  topicId         String
  subtopicId      String?
  categoryId      String?
  difficulty      Int?
  timeMs          Int?
  isReviewed      Boolean  @default(false)
  createdAt       DateTime @default(now())

  user            User      @relation(fields: [userId], references: [id])
  question        Question  @relation(fields: [questionId], references: [id])
}

model Remedial {
  id              String   @id @default(cuid())
  userId          String
  originalQuestionId String?
  topicId         String?
  subtopicId      String?
  questionText    String
  options         String   @default("[]")
  correctAnswer   String
  explanation     String?
  difficulty      Int      @default(1)
  isCompleted     Boolean  @default(false)
  isCorrect       Boolean?
  createdAt       DateTime @default(now())
  completedAt     DateTime?

  user            User      @relation(fields: [userId], references: [id])
}

model UserProgress {
  id              String   @id @default(cuid())
  userId          String   @unique
  totalQuestions  Int      @default(0)
  totalCorrect    Int      @default(0)
  totalWrong      Int      @default(0)
  accuracy        Float    @default(0)
  totalXP         Int      @default(0)
  totalTimeMs     Int      @default(0)
  topicsStudied   Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User      @relation(fields: [userId], references: [id])
}

model TopicProgress {
  id              String   @id @default(cuid())
  userId          String
  topicId         String
  questionsAttempted Int  @default(0)
  correctCount    Int      @default(0)
  wrongCount      Int      @default(0)
  accuracy        Float    @default(0)
  lastAttemptAt   DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User      @relation(fields: [userId], references: [id])
  topic           Topic     @relation(fields: [topicId], references: [id])

  @@unique([userId, topicId])
}

model Bookmark {
  id              String   @id @default(cuid())
  userId          String
  questionId      String
  note            String?
  createdAt       DateTime @default(now())

  user            User      @relation(fields: [userId], references: [id])

  @@unique([userId, questionId])
}

model Simulation {
  id              String   @id @default(cuid())
  userId          String
  type            String
  totalQuestions  Int
  correctCount    Int
  wrongCount      Int
  unansweredCount Int      @default(0)
  score           Float
  timeLimitSec    Int
  timeUsedMs      Int
  startedAt       DateTime
  completedAt     DateTime?
  isCompleted     Boolean  @default(false)
  createdAt       DateTime @default(now())

  user            User      @relation(fields: [userId], references: [id])
  attempts        Attempt[]
}

model Achievement {
  id              String   @id @default(cuid())
  name            String
  description     String
  icon            String?
  condition       String
  xpReward        Int      @default(0)
  createdAt       DateTime @default(now())

  users           UserAchievement[]
}

model UserAchievement {
  id              String   @id @default(cuid())
  userId          String
  achievementId   String
  unlockedAt      DateTime @default(now())

  user            User      @relation(fields: [userId], references: [id])
  achievement     Achievement @relation(fields: [achievementId], references: [id])

  @@unique([userId, achievementId])
}

model StudySession {
  id              String   @id @default(cuid())
  userId          String
  topicId         String?
  questionsCount  Int      @default(0)
  correctCount    Int      @default(0)
  durationMs      Int      @default(0)
  startedAt       DateTime @default(now())
  endedAt         DateTime?

  user            User      @relation(fields: [userId], references: [id])
}
